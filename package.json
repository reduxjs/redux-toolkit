{
  "name": "rtk-monorepo",
  "private": true,
  "description": "The official, opinionated, batteries-included toolset for efficient Redux development",
  "author": "Mark Erikson <mark@isquaredsoftware.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reduxjs/redux-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/reduxjs/redux-toolkit/issues"
  },
  "homepage": "https://redux-toolkit.js.org",
  "directories": {
    "example": "example"
  },
  "devDependencies": {
    "@babel/code-frame": "^7.24.2",
    "@babel/core": "^7.24.3",
    "@babel/generator": "^7.24.1",
    "@babel/helper-compilation-targets": "^7.23.6",
    "@babel/traverse": "^7.24.1",
    "@babel/types": "^7.24.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "netlify-plugin-cache": "^1.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pkg-pr-new": "^0.0.75",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.2",
    "release-it": "^14.12.5",
    "serve": "^14.2.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "pnpm build:packages",
    "test": "pnpm test:packages",
    "lint": "oxlint packages/toolkit/src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:examples": "pnpm --recursive --filter \"@reduxjs/*\" --filter \"@examples-query-react/*\" run build",
    "build:docs": "pnpm --filter website run build",
    "build:packages": "pnpm --recursive --filter \"@reduxjs/*\" --filter \"@rtk-query/*\" run build",
    "test:packages": "pnpm --recursive --filter \"@reduxjs/*\" --filter \"@rtk-query/*\" run test",
    "dev:docs": "pnpm --filter website run start"
  },
  "packageManager": "pnpm@11.22.0"
}

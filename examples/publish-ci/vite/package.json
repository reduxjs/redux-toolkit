{
  "name": "rtk-esm-vite-normal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve-app": "yarn serve -s dist",
    "check-bundle": "node ../scripts/check-bundled-modules.mjs dist",
    "test": "yarn check-bundle && yarn playwright test",
    "format": "prettier --write \"./src/**/*.{ts,tsx}\" \"**/*.md\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "msw": "^1.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^27.5.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6",
    "prettier": "^3.2.5",
    "serve": "^14.2.0",
    "typescript": "^6.0.3",
    "vite": "^8"
  },
  "msw": {
    "workerDirectory": "public"
  }
}

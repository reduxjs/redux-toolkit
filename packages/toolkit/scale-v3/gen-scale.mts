/**
 * Generates instantiation-cost scale fixtures for the v3 (spread-phantom)
 * API against the REAL RTKQ type surface, plus current builder-API
 * baselines compiled in the same source mode so the comparison is
 * apples-to-apples.
 *
 * Per entity e: getThing{e} (byId query, transformResponse + providesTags),
 * getThing{e}List (list query; upsert -> byId in the upsert variants),
 * updateThing{e} (mutation, invalidatesTags). 3 endpoints per entity.
 *
 * Run: bun gen-scale.mts
 */
import { mkdirSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

const sizes: Array<{ entities: number; endpoints: number }> = [
  { entities: 4, endpoints: 12 },
  { entities: 17, endpoints: 51 },
  { entities: 34, endpoints: 102 },
  { entities: 67, endpoints: 201 },
]

const outDir = join(import.meta.dirname, 'fixtures')
mkdirSync(outDir, { recursive: true })

const tagTypes = `['TagA', 'TagB', 'TagC', 'TagD', 'TagE'] as const`

function header(comment: string) {
  return `// GENERATED by gen-scale.mts — ${comment}\n// prettier-ignore\n/* eslint-disable */\n`
}

function domainTypes(entities: number) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `interface Thing${e} { id: string; name: string; score${e}: number }\n`
    out += `interface Raw${e} { data: Thing${e}[]; fetchedAt: number }\n`
  }
  return out
}

function v3Endpoints(entities: number, withUpsert: boolean) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `    getThing${e}: {
      ...query<Thing${e}, string>(),
      request: (id) => \`/thing${e}/\${id}\`,
      providesTags: (result, error, id) => [{ type: 'TagA' as const, id }],
    },
    getThing${e}List: {
      ...query<Thing${e}[], void, Raw${e}>(),
      request: () => '/thing${e}',
      transformResponse: (raw) => raw.data,
      providesTags: ['TagB'],${
        withUpsert
          ? `
      upsert: (things) =>
        things.map((t) => ({
          endpoint: 'getThing${e}' as const,
          arg: t.id,
          value: t,
        })),`
          : ''
      }
    },
    updateThing${e}: {
      ...mutation<Thing${e}, Partial<Thing${e}> & { id: string }>(),
      request: (patch) => ({ url: \`/thing${e}/\${patch.id}\`, method: 'PATCH', body: patch }),
      invalidatesTags: (result, error, arg) => [{ type: 'TagA' as const, id: arg.id }, 'TagB'],
    },
`
  }
  return out
}

function currentEndpoints(entities: number) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `    getThing${e}: build.query<Thing${e}, string>({
      query: (id) => \`/thing${e}/\${id}\`,
      providesTags: (result, error, id) => [{ type: 'TagA' as const, id }],
    }),
    getThing${e}List: build.query<Thing${e}[], void, Raw${e}>({
      query: () => '/thing${e}',
      transformResponse: (raw) => raw.data,
      providesTags: ['TagB'],
    }),
    updateThing${e}: build.mutation<Thing${e}, Partial<Thing${e}> & { id: string }>({
      query: (patch) => ({ url: \`/thing${e}/\${patch.id}\`, method: 'PATCH', body: patch }),
      invalidatesTags: (result, error, arg) => [{ type: 'TagA' as const, id: arg.id }, 'TagB'],
    }),
`
  }
  return out
}

function hookRefs(entities: number, apiName: string) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `const useQ${e} = ${apiName}.useGetThing${e}Query\n`
    out += `const useL${e} = ${apiName}.useGetThing${e}ListQuery\n`
    out += `const useM${e} = ${apiName}.useUpdateThing${e}Mutation\n`
  }
  return out
}

function endpointRefs(entities: number, apiName: string) {
  // reference each endpoint's initiate/select so core-only fixtures
  // instantiate the endpoint surface, mirroring what an app touches
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `const ini${e} = ${apiName}.endpoints.getThing${e}.initiate\n`
    out += `const sel${e} = ${apiName}.endpoints.getThing${e}List.select\n`
    out += `const mut${e} = ${apiName}.endpoints.updateThing${e}.initiate\n`
  }
  return out
}

for (const { entities, endpoints } of sizes) {
  // v3 core, with upsert
  writeFileSync(
    join(outDir, `v3-core-upsert-${endpoints}.ts`),
    header(`v3 core, ${endpoints} endpoints, with upsert`) +
      `import { createApi, query, mutation } from '../../src/query/v3'
import { fetchBaseQuery } from '../../src/query'

${domainTypes(entities)}
const api = createApi({
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
  endpoints: {
${v3Endpoints(entities, true)}  },
})

${endpointRefs(entities, 'api')}
export { api }
`,
  )

  // v3 core, no upsert
  writeFileSync(
    join(outDir, `v3-core-noupsert-${endpoints}.ts`),
    header(`v3 core, ${endpoints} endpoints, no upsert`) +
      `import { createApi, query, mutation } from '../../src/query/v3'
import { fetchBaseQuery } from '../../src/query'

${domainTypes(entities)}
const api = createApi({
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
  endpoints: {
${v3Endpoints(entities, false)}  },
})

${endpointRefs(entities, 'api')}
export { api }
`,
  )

  // v3 reactified (with upsert), every hook referenced once
  writeFileSync(
    join(outDir, `v3-react-${endpoints}.ts`),
    header(`v3 reactify, ${endpoints} endpoints, with upsert, all hooks referenced`) +
      `import { createApi, query, mutation } from '../../src/query/v3'
import { reactify } from '../../src/query/v3/react'
import { fetchBaseQuery } from '../../src/query'

${domainTypes(entities)}
const api = createApi({
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
  endpoints: {
${v3Endpoints(entities, true)}  },
})

const rapi = reactify(api)

${hookRefs(entities, 'rapi')}
export { rapi }
`,
  )

  // current builder API, core entry
  writeFileSync(
    join(outDir, `current-core-${endpoints}.ts`),
    header(`current builder API, core entry, ${endpoints} endpoints`) +
      `import { createApi, fetchBaseQuery } from '../../src/query'

${domainTypes(entities)}
const api = createApi({
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
  endpoints: (build) => ({
${currentEndpoints(entities)}  }),
})

${endpointRefs(entities, 'api')}
export { api }
`,
  )

  // current builder API, react entry, all hooks referenced
  writeFileSync(
    join(outDir, `current-react-${endpoints}.ts`),
    header(`current builder API, react entry, ${endpoints} endpoints, all hooks referenced`) +
      `import { createApi, fetchBaseQuery } from '../../src/query/react'

${domainTypes(entities)}
const api = createApi({
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
  endpoints: (build) => ({
${currentEndpoints(entities)}  }),
})

${hookRefs(entities, 'api')}
export { api }
`,
  )
}

console.log(`Generated ${sizes.length * 5} fixtures in ${outDir}`)

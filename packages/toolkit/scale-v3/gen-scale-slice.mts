/**
 * Generates instantiation-cost scale fixtures for the v3 createSlice
 * prototype against the 2.x createSlice, in the same source mode.
 *
 * Per slice i: three case reducers (payload, no-payload, prepared in the
 * object form; payload, no-payload, asyncThunk in the callback form) plus
 * one slice selector. actions/reducer/selectors are all exported so nothing
 * is dropped from checking.
 *
 * Variants:
 * - slice-cur-obj-N / slice-v3-obj-N: object-form reducers
 * - slice-cur-cb-N: 2.x callback form via buildCreateSlice + asyncThunkCreator symbol
 * - slice-v3-cb-N: v3 callback form via creators: (ctx) => ({ asyncThunk: asyncThunkCreator(ctx) })
 *
 * Run: bun scale-v3/gen-scale-slice.mts, then bun scale-v3/measure.mts slice-
 */
import { mkdirSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

const sizes = [10, 50, 100, 200]

const outDir = join(import.meta.dirname, 'fixtures')
mkdirSync(outDir, { recursive: true })

function header(comment: string) {
  return `// GENERATED by gen-scale-slice.mts — ${comment}\n// prettier-ignore\n/* eslint-disable */\n`
}

function domainTypes(n: number) {
  let out = ''
  for (let i = 0; i < n; i++) {
    out += `interface Item${i} { id: string; label${i}: string }\n`
  }
  return out
}

function objSlice(i: number, createFn: string) {
  return `const slice${i} = ${createFn}({
  name: 'slice${i}',
  initialState: { list: [] as Item${i}[], status: 'idle' },
  reducers: {
    added(state, action: PayloadAction<Item${i}>) {
      state.list.push(action.payload)
    },
    cleared(state) {
      state.list = []
    },
    prepared: {
      prepare(label: string) {
        return { payload: { id: 'x', label${i}: label } as Item${i} }
      },
      reducer(state, action: PayloadAction<Item${i}>) {
        state.list.push(action.payload)
      },
    },
  },
  selectors: {
    selectList: (state) => state.list,
  },
})
export const reducer${i} = slice${i}.reducer
export const actions${i} = slice${i}.actions
export const selectors${i} = slice${i}.selectors
`
}

function cbSliceBody(i: number) {
  return `  name: 'slice${i}',
  initialState: { list: [] as Item${i}[], status: 'idle' },
  reducers: (create) => ({
    added: create.reducer<Item${i}>((state, action) => {
      state.list.push(action.payload)
    }),
    cleared: create.reducer((state) => {
      state.list = []
    }),
    fetchItem: create.asyncThunk(
      async (id: string) => ({ id, label${i}: id }) as Item${i},
      {
        pending(state) {
          state.status = 'pending'
        },
        fulfilled(state, action) {
          state.status = 'done'
          state.list.push(action.payload)
        },
      },
    ),
  }),
  selectors: {
    selectList: (state) => state.list,
  },
`
}

function exportsFor(i: number) {
  return `export const reducer${i} = slice${i}.reducer
export const actions${i} = slice${i}.actions
export const selectors${i} = slice${i}.selectors
`
}

function genCurObj(n: number) {
  let out = header(`2.x createSlice, object form, ${n} slices`)
  out += `import { createSlice } from '../../src'\n`
  out += `import type { PayloadAction } from '../../src'\n\n`
  out += domainTypes(n)
  out += '\n'
  for (let i = 0; i < n; i++) out += objSlice(i, 'createSlice') + '\n'
  return out
}

function genV3Obj(n: number) {
  let out = header(`v3 createSlice, object form, ${n} slices`)
  out += `import { createSlice } from '../../src/v3'\n`
  out += `import type { PayloadAction } from '../../src'\n\n`
  out += domainTypes(n)
  out += '\n'
  for (let i = 0; i < n; i++) out += objSlice(i, 'createSlice') + '\n'
  return out
}

function genCurCb(n: number) {
  let out = header(
    `2.x createSlice, callback form via buildCreateSlice + asyncThunkCreator symbol, ${n} slices`,
  )
  out += `import { buildCreateSlice, asyncThunkCreator } from '../../src'\n\n`
  out += `const createAppSlice = buildCreateSlice({ creators: { asyncThunk: asyncThunkCreator } })\n\n`
  out += domainTypes(n)
  out += '\n'
  for (let i = 0; i < n; i++) {
    out += `const slice${i} = createAppSlice({\n${cbSliceBody(i)}})\n`
    out += exportsFor(i) + '\n'
  }
  return out
}

function genV3Cb(n: number) {
  let out = header(
    `v3 createSlice, callback form via per-call creators option, ${n} slices`,
  )
  out += `import { createSlice, asyncThunkCreator } from '../../src/v3'\n\n`
  out += domainTypes(n)
  out += '\n'
  for (let i = 0; i < n; i++) {
    out += `const slice${i} = createSlice({\n`
    out += `  creators: (ctx) => ({ asyncThunk: asyncThunkCreator(ctx) }),\n`
    out += cbSliceBody(i)
    out += `})\n`
    out += exportsFor(i) + '\n'
  }
  return out
}

for (const n of sizes) {
  writeFileSync(join(outDir, `slice-cur-obj-${n}.ts`), genCurObj(n))
  writeFileSync(join(outDir, `slice-v3-obj-${n}.ts`), genV3Obj(n))
  writeFileSync(join(outDir, `slice-cur-cb-${n}.ts`), genCurCb(n))
  writeFileSync(join(outDir, `slice-v3-cb-${n}.ts`), genV3Cb(n))
}

console.log(`Wrote ${sizes.length * 4} slice fixtures to ${outDir}`)

/**
 * Generates fixtures for the hybrid bound-creators experiment.
 * Mirrors gen-scale.mts exactly except endpoint bodies live inside
 * bound creator calls and cells are thin { kind, upsert? } shells.
 *
 * Run: bun gen-hybrid.mts
 */
import { writeFileSync } from 'node:fs'
import { join } from 'node:path'

const sizes: Array<{ entities: number; endpoints: number }> = [
  { entities: 4, endpoints: 12 },
  { entities: 17, endpoints: 51 },
  { entities: 34, endpoints: 102 },
  { entities: 67, endpoints: 201 },
]

const outDir = join(import.meta.dirname, 'fixtures')

const tagTypes = `['TagA', 'TagB', 'TagC', 'TagD', 'TagE'] as const`

function header(comment: string) {
  return `// GENERATED by gen-hybrid.mts — ${comment}\n// prettier-ignore\n/* eslint-disable */\n`
}

function domainTypes(entities: number) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `interface Thing${e} { id: string; name: string; score${e}: number }\n`
    out += `interface Raw${e} { data: Thing${e}[]; fetchedAt: number }\n`
  }
  return out
}

function hybridEndpoints(entities: number, withUpsert: boolean) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `    getThing${e}: {
      kind: c.query<Thing${e}, string>({
        request: (id) => \`/thing${e}/\${id}\`,
        providesTags: (result, error, id) => [{ type: 'TagA' as const, id }],
      }),
    },
    getThing${e}List: {
      kind: c.query<Thing${e}[], void, Raw${e}>({
        request: () => '/thing${e}',
        transformResponse: (raw) => raw.data,
        providesTags: ['TagB'],
      }),${
        withUpsert
          ? `
      upsert: (things) =>
        things.map((t) => ({
          endpoint: 'getThing${e}' as const,
          arg: t.id,
          value: t,
        })),`
          : ''
      }
    },
    updateThing${e}: {
      kind: c.mutation<Thing${e}, Partial<Thing${e}> & { id: string }>({
        request: (patch) => ({ url: \`/thing${e}/\${patch.id}\`, method: 'PATCH', body: patch }),
        invalidatesTags: (result, error, arg) => [{ type: 'TagA' as const, id: arg.id }, 'TagB'],
      }),
    },
`
  }
  return out
}

function endpointRefs(entities: number, apiName: string) {
  let out = ''
  for (let e = 0; e < entities; e++) {
    out += `const ini${e} = ${apiName}.endpoints.getThing${e}.initiate\n`
    out += `const sel${e} = ${apiName}.endpoints.getThing${e}List.select\n`
    out += `const mut${e} = ${apiName}.endpoints.updateThing${e}.initiate\n`
  }
  return out
}

for (const { entities, endpoints } of sizes) {
  for (const withUpsert of [true, false]) {
    const variant = withUpsert ? 'upsert' : 'noupsert'
    writeFileSync(
      join(outDir, `hybrid-core-${variant}-${endpoints}.ts`),
      header(`hybrid bound creators, ${endpoints} endpoints, ${variant}`) +
        `import { fetchBaseQuery } from '../../src/query'
import { boundCreators, createApiHybrid } from './hybrid-support'

${domainTypes(entities)}
const c = boundCreators(fetchBaseQuery({ baseUrl: '/api' }), {
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
})

const api = createApiHybrid({
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ${tagTypes},
  reducerPath: 'scaleApi',
  endpoints: {
${hybridEndpoints(entities, withUpsert)}  },
})

${endpointRefs(entities, 'api')}
export { api }
`,
    )
  }
}
console.log('hybrid fixtures written')

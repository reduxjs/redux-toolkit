{
  "openapi": "3.0.0",
  "info": {
    "title": "Descriptions containing a comment terminator",
    "version": "1.0.0"
  },
  "paths": {
    "/files/{id}": {
      "put": {
        "operationId": "putFile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept",
            "in": "query",
            "description": "Media range, defaults to */*",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "File contents, */* or text/* with */* fallback",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored file, any type (*/*)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}

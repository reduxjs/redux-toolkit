  },
  "components": {
    "schemas": {
      "FormData": {
        "type": "object",
        "properties": {
          "caption": {
            "type": "string"
          }
        },
        "required": ["caption"]
      },
      "Blob": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number"
          }
        },
        "required": ["width"]
      },
      "BinaryPart": {
        "type": "string",
        "format": "binary"
      },
      "composed-upload": {
        "type": "object",
        "properties": {
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BinaryPart"
              },
              {
                "type": "string"
              }
            ]
          },
          "intersected": {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "blobPart": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "localBlob": {
            "$ref": "#/components/schemas/Blob"
          },
          "binaryDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "binary"
            }
          }
        },
        "required": [
          "payload",
          "intersected"
        ]
      }
    }
  }
}

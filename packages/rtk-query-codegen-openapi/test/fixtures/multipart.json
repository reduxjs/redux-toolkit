    "/api/EncodedMultipart": {
      "post": {
        "operationId": "encodedMultipart",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "author": {
                        "type": "string"
                      }
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "wild": {
                    "type": "string"
                  },
                  "multi": {
                    "type": "string"
                  },
                  "opaque": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "encoding": {
                "metadata": {
                  "contentType": "application/vnd.custom+json"
                },
                "label": {
                  "contentType": "text/html; charset=utf-8"
                },
                "file": {
                  "contentType": "image/png"
                },
                "wild": {
                  "contentType": "image/*"
                },
                "multi": {
                  "contentType": "text/plain, application/json"
                },
                "opaque": {
                  "contentType": "application/octet-stream"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/UploadOrProblemJson": {
      "post": {
        "operationId": "uploadOrProblemJson",
        "requestBody": {
          "required": true,

    "/api/UppercaseNoPartMultipart": {
      "post": {
        "operationId": "uppercaseNoPartMultipart",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "optionalUppercase": {
                    "type": "string"
                  },
                  "uppercaseList": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "encoding": {
                "optionalUppercase": {
                  "contentType": "text/plain; foo=A"
                },
                "uppercaseList": {
                  "contentType": "text/plain; foo=A"
                }
              }
            }
          }
        },
        "responses": {
          "200": {

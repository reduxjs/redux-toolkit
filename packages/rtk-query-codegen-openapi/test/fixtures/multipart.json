{
  "openapi": "3.0.0",
  "info": {
    "title": "Multipart upload API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Avatar": {
      "post": {
        "operationId": "uploadAvatar",
        "tags": ["Avatar"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number"
                  },
                  "published": {
                    "type": "boolean"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "meta": {
                    "type": "object",
                    "properties": {
                      "author": {
                        "type": "string"
                      }
                    }
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },

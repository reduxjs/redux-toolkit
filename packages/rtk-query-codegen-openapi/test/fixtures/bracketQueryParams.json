{
  "openapi": "3.0.0",
  "info": {
    "title": "Bracketed query parameter names",
    "version": "1.0.0"
  },
  "paths": {
    "/books": {
      "get": {
        "operationId": "getBooks",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status[]",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "ids[]",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "order[title]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "getProducts",
        "parameters": [
          {
            "name": "price",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price[gt]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price[lt]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
